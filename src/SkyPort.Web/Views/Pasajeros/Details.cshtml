@model SkyPort.Web.Models.PasajeroViewModel
@using SkyPort.Application.Common.Constants
@{
    ViewData["Title"] = "Detalle del pasajero";
    var puedeEditar = User.IsInRole(Roles.Administrador) || User.IsInRole(Roles.AgenteCheckIn);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">@Model.Nombres @Model.Apellidos</h1>
        <p class="text-secondary mb-0">@Model.TipoDocumento @Model.NumeroDocumento</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">Volver a pasajeros</a>
        @if (puedeEditar)
        {
            <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.PasajeroId">Editar</a>
            <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.PasajeroId">Eliminar</a>
        }
    </div>
</div>

<section class="card shadow-sm">
    <div class="card-header bg-white"><h2 class="h5 mb-0">Datos personales</h2></div>
    <dl class="row card-body mb-0">
        <dt class="col-sm-4">Tipo de documento</dt><dd class="col-sm-8">@Model.TipoDocumento</dd>
        <dt class="col-sm-4">Número de documento</dt><dd class="col-sm-8">@Model.NumeroDocumento</dd>
        <dt class="col-sm-4">Fecha de nacimiento</dt><dd class="col-sm-8">@Model.FechaNacimiento.ToString("dd/MM/yyyy")</dd>
        <dt class="col-sm-4">Nacionalidad</dt><dd class="col-sm-8">@Model.Nacionalidad</dd>
        <dt class="col-sm-4">Correo electrónico</dt><dd class="col-sm-8">@(Model.Email ?? "—")</dd>
        <dt class="col-sm-4">Teléfono</dt><dd class="col-sm-8">@(Model.Telefono ?? "—")</dd>
    </dl>
    <div class="card-footer bg-white">
        <a class="btn btn-outline-primary" asp-controller="Reservas" asp-action="Index" asp-route-pasajeroId="@Model.PasajeroId">Ver sus reservas</a>
    </div>
</section>
