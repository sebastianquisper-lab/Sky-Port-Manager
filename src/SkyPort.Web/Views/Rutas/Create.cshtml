@model SkyPort.Web.Models.RutaViewModel
@{
    ViewData["Title"] = "Crear ruta";
}

<h1 class="h2 mb-4">Crear ruta</h1>
<div class="card shadow-sm"><div class="card-body">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="CodigoOrigen" class="form-label"></label><input asp-for="CodigoOrigen" class="form-control text-uppercase" maxlength="3" /><span asp-validation-for="CodigoOrigen" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="CiudadOrigen" class="form-label"></label><input asp-for="CiudadOrigen" class="form-control" maxlength="80" /><span asp-validation-for="CiudadOrigen" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="CodigoDestino" class="form-label"></label><input asp-for="CodigoDestino" class="form-control text-uppercase" maxlength="3" /><span asp-validation-for="CodigoDestino" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="CiudadDestino" class="form-label"></label><input asp-for="CiudadDestino" class="form-control" maxlength="80" /><span asp-validation-for="CiudadDestino" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="DuracionMinutos" class="form-label"></label><input asp-for="DuracionMinutos" class="form-control" min="1" /><span asp-validation-for="DuracionMinutos" class="text-danger"></span></div>
        </div>
        <div class="mt-4"><button type="submit" class="btn btn-primary">Crear ruta</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
