@model SkyPort.Application.Common.PagedResult<SkyPort.Application.Dtos.Boletos.BoletoDto>
@{ ViewData["Title"] = "Boletos"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h2">Boletos</h1><p class="text-secondary">@Model.TotalCount boletos emitidos</p></div>@if (User.IsInRole(SkyPort.Application.Common.Constants.Roles.Administrador) || User.IsInRole(SkyPort.Application.Common.Constants.Roles.AgenteCheckIn)) { <a asp-action="Create" class="btn btn-primary">Emitir boleto</a> }</div>
<div class="table-responsive"><table class="table table-hover align-middle">
<thead><tr><th>Código</th><th>Reserva</th><th>Pasajero</th><th>Vuelo</th><th>Fecha de emisión</th><th>Estado</th></tr></thead>
<tbody>
@if (Model.Items.Count == 0) { <tr><td colspan="6" class="text-center text-secondary py-4">No hay boletos emitidos.</td></tr> }
@foreach (var item in Model.Items) { <tr><td><a asp-action="Details" asp-route-id="@item.BoletoId">@item.CodigoBoleto</a></td><td>@item.CodigoReserva</td><td>@item.NombrePasajero</td><td>@item.NumeroVuelo · @item.Asiento</td><td>@item.FechaEmision.ToString("dd/MM/yyyy HH:mm")</td><td>@item.Estado</td></tr> }
</tbody></table></div>
@await Html.PartialAsync("_Pagination")
