@model IReadOnlyList<SkyPort.Application.Dtos.Terminales.TerminalDto>
@{ ViewData["Title"] = "Terminales"; }
<h1>Terminales</h1>
<a asp-action="Create" class="btn btn-primary">Registrar terminal</a>
@if (Model.Count == 0)
{
    <p>No hay terminales registradas.</p>
}
else
{
    <table class="table">
        <thead><tr><th>Id</th><th>Nombre</th></tr></thead>
        <tbody>
        @foreach (var terminal in Model)
        {
            <tr><td><a asp-action="Details" asp-route-id="@terminal.TerminalId">@terminal.TerminalId</a></td><td>@terminal.Nombre</td></tr>
        }
        </tbody>
    </table>
}
