@model SkyPort.Application.Common.PagedResult<SkyPort.Application.Dtos.CheckIn.CheckInDto>
@{ ViewData["Title"] = "Check-in"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h2">Check-in</h1><p class="text-secondary">@Model.TotalCount registros</p></div>@if (User.IsInRole(SkyPort.Application.Common.Constants.Roles.Administrador) || User.IsInRole(SkyPort.Application.Common.Constants.Roles.AgenteCheckIn)) { <a asp-action="Create" class="btn btn-primary">Registrar check-in</a> }</div>
<div class="table-responsive"><table class="table table-hover align-middle">
<thead><tr><th>Boleto</th><th>Reserva</th><th>Pasajero</th><th>Empleado</th><th>Fecha</th><th>Documento verificado</th></tr></thead><tbody>
@if (Model.Items.Count == 0) { <tr><td colspan="6" class="text-center text-secondary py-4">No hay registros de check-in.</td></tr> }
@foreach (var item in Model.Items) { <tr><td><a asp-action="Details" asp-route-id="@item.CheckInId">@item.CodigoBoleto</a></td><td>@item.CodigoReserva</td><td>@item.NombrePasajero</td><td>@(item.NombreEmpleado ?? "Sin asignar")</td><td>@item.FechaHora.ToString("dd/MM/yyyy HH:mm")</td><td>@(item.DocumentoVerificado ? "Sí" : "No")</td></tr> }
</tbody></table></div>
@await Html.PartialAsync("_Pagination")
