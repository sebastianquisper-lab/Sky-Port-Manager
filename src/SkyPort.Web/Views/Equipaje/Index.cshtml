@model IReadOnlyList<SkyPort.Application.Dtos.Equipajes.EquipajeDto>
@{ ViewData["Title"] = "Equipajes"; }
<h1>Equipajes</h1>
@if (Model.Count == 0)
{
    <p>No hay equipajes registrados.</p>
}
else
{
    <table class="table">
        <thead><tr><th>Código</th><th>Boleto</th><th>Peso (kg)</th><th>Estado</th></tr></thead>
        <tbody>
        @foreach (var baggage in Model)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@baggage.EquipajeId">@baggage.Codigo</a></td>
                <td>@baggage.CodigoBoleto (Id @baggage.BoletoId)</td>
                <td>@baggage.PesoKg.ToString("0.00")</td>
                <td>@baggage.Estado</td>
            </tr>
        }
        </tbody>
    </table>
}
