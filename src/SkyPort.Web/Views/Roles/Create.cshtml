@model SkyPort.Web.Models.RolViewModel
@{
    ViewData["Title"] = "Crear rol";
}

<h1 class="h2 mb-4">Crear rol</h1>
<div class="card shadow-sm"><div class="card-body">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
        <button type="submit" class="btn btn-primary">Crear</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
