@model IReadOnlyList<SkyPort.Application.Dtos.Empleados.EmpleadoDto>
@{ ViewData["Title"] = "Personal"; }
<h1>Personal</h1>
<a asp-action="Create" class="btn btn-primary">Registrar empleado</a>
@if (Model.Count == 0)
{
    <p>No hay empleados registrados.</p>
}
else
{
    <table class="table">
        <thead><tr><th>Documento</th><th>Apellidos</th><th>Nombres</th><th>Cargo</th><th>Correo</th><th>Activo</th></tr></thead>
        <tbody>
        @foreach (var employee in Model)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@employee.EmpleadoId">@employee.NumeroDocumento</a></td>
                <td>@employee.Apellidos</td>
                <td>@employee.Nombres</td>
                <td>@employee.Cargo</td>
                <td>@employee.Email</td>
                <td>@(employee.Activo is true ? "Sí" : employee.Activo is false ? "No" : "Sin dato")</td>
            </tr>
        }
        </tbody>
    </table>
}
