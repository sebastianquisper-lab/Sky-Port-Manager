@model IReadOnlyList<SkyPort.Application.Dtos.Vuelos.VueloListItemDto>
@{
    ViewData["Title"] = "Vuelos";
    var puedeGestionar = User.IsInRole(SkyPort.Application.Common.Constants.Roles.Administrador) ||
                         User.IsInRole(SkyPort.Application.Common.Constants.Roles.OperadorVuelos);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div><h1 class="h2 mb-1">Vuelos</h1><p class="text-secondary mb-0">Consulta vuelos, rutas, aeronaves y horarios.</p></div>
    @if (puedeGestionar) { <a class="btn btn-primary" asp-action="Create">Crear vuelo</a> }
</div>
<div class="card shadow-sm"><div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead><tr><th>Vuelo</th><th>Ruta</th><th>Aeronave</th><th>Puerta</th><th>Salida</th><th>Llegada</th><th>Estado</th><th></th></tr></thead>
        <tbody>
        @if (Model.Count == 0)
        {
            <tr><td colspan="8" class="text-center text-secondary py-4">No hay vuelos registrados.</td></tr>
        }
        else
        {
            @foreach (var flight in Model)
            {
                <tr>
                    <th scope="row">@flight.NumeroVuelo</th><td>@flight.Ruta</td><td>@flight.MatriculaAeronave</td>
                    <td>@(flight.Puerta ?? "Sin asignar")</td>
                    <td>@flight.FechaSalida.ToString("yyyy-MM-dd HH:mm")</td><td>@flight.FechaLlegada.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@flight.Estado</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@flight.VueloId">Ver</a>
                        @if (puedeGestionar) { <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@flight.VueloId">Eliminar</a> }
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div></div>
