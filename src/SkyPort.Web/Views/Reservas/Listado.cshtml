@model SkyPort.Application.Common.PagedResult<SkyPort.Application.UseCases.Reservas.Dtos.ReservaDto>
@using SkyPort.Application.Common.Constants
@{ ViewData["Title"] = "Todas las reservas"; }
<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h1 class="h2 mb-1">Todas las reservas</h1><p class="text-secondary mb-0">@Model.TotalCount reservas registradas</p></div>
    <a asp-action="Index" class="btn btn-outline-secondary">Vuelos disponibles</a>
</div>
<div class="table-responsive"><table class="table table-hover align-middle">
    <thead><tr><th>Código</th><th>Pasajero</th><th>Vuelo</th><th>Asiento</th><th>Fecha</th><th>Estado</th></tr></thead>
    <tbody>
    @if (Model.Items.Count == 0) { <tr><td colspan="6" class="text-center text-secondary py-4">No hay reservas registradas.</td></tr> }
    @foreach (var reserva in Model.Items)
    {
        <tr><td>@reserva.Codigo</td><td>@reserva.NombrePasajero<br /><small class="text-secondary">@reserva.TipoDocumento @reserva.NumeroDocumento</small></td><td>@reserva.NumeroVuelo<br /><small class="text-secondary">@reserva.Ruta</small></td><td>@reserva.Asiento</td><td>@reserva.FechaReserva.ToString("dd/MM/yyyy HH:mm")</td><td>@reserva.Estado</td></tr>
    }
    </tbody>
</table></div>
@await Html.PartialAsync("_Pagination")
