@{
    var page = Convert.ToInt32(ViewData["Page"] ?? 1);
    var pageSize = Convert.ToInt32(ViewData["PageSize"] ?? 10);
    var total = Convert.ToInt32(ViewData["Total"] ?? 0);
    var routeValues = ViewData["RouteValues"] as IDictionary<string, string> ?? new Dictionary<string, string>();
    var pageCount = pageSize > 0 ? (int)Math.Ceiling(total / (double)pageSize) : 0;
}
@if (pageCount > 1)
{
    <nav aria-label="Paginación">
        <ul class="pagination justify-content-end">
            <li class="page-item @(page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-route-page="@(page - 1)" asp-route-pageSize="@pageSize" asp-all-route-data="routeValues" aria-label="Página anterior">Anterior</a>
            </li>
            @for (var pageNumber = 1; pageNumber <= pageCount; pageNumber++)
            {
                <li class="page-item @(pageNumber == page ? "active" : "")">
                    <a class="page-link" asp-route-page="@pageNumber" asp-route-pageSize="@pageSize" asp-all-route-data="routeValues" aria-current="@(pageNumber == page ? "page" : null)">@pageNumber</a>
                </li>
            }
            <li class="page-item @(page >= pageCount ? "disabled" : "")">
                <a class="page-link" asp-route-page="@(page + 1)" asp-route-pageSize="@pageSize" asp-all-route-data="routeValues" aria-label="Página siguiente">Siguiente</a>
            </li>
        </ul>
    </nav>
}
