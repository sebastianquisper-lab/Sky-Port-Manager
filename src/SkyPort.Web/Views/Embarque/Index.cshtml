@model IReadOnlyList<SkyPort.Application.Dtos.Embarques.EmbarqueListItemDto>
@{
    ViewData["Title"] = "Embarques";
}

<div class="mb-4"><h1 class="h2 mb-1">Embarques</h1><p class="text-secondary mb-0">Consulta los registros de embarque.</p></div>

<div class="card shadow-sm"><div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead><tr><th>Boleto</th><th>Pasajero</th><th>Vuelo</th><th>Puerta</th><th>Fecha y hora</th></tr></thead>
        <tbody>
        @if (Model.Count == 0)
        {
            <tr><td colspan="5" class="text-center text-secondary py-4">No hay embarques registrados.</td></tr>
        }
        else
        {
            @foreach (var boarding in Model)
            {
                <tr>
                    <th scope="row">@boarding.CodigoBoleto</th><td>@boarding.Pasajero</td><td>@boarding.NumeroVuelo</td>
                    <td>@(boarding.Puerta ?? "Sin asignar")</td><td>@boarding.FechaHora.ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
            }
        }
        </tbody>
    </table>
</div></div>
