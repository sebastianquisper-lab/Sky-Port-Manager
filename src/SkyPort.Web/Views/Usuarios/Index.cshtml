@model IReadOnlyList<SkyPort.Web.Models.Users.UsuarioViewModel>
@using SkyPort.Application.Common.Constants
@{
    ViewData["Title"] = "Usuarios";
    var roles = new[] { Roles.Administrador, Roles.OperadorVuelos, Roles.AgenteCheckIn };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Usuarios</h1>
        <p class="text-muted mb-0">Administra las cuentas, sus roles y el acceso al sistema.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Crear usuario</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="alert">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">Todavía no hay usuarios registrados.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead><tr><th>Nombre completo</th><th>Correo</th><th>Rol</th><th>Estado</th><th>Acciones</th></tr></thead>
            <tbody>
            @foreach (var usuario in Model)
            {
                <tr>
                    <td>@usuario.NombreCompleto</td>
                    <td>@usuario.Email</td>
                    <td>
                        <form asp-action="CambiarRol" method="post" class="d-flex gap-2">
                            <input type="hidden" name="UserId" value="@usuario.UserId" />
                            <select name="Role" class="form-select form-select-sm" aria-label="Rol de @usuario.Email">
                                @foreach (var role in roles)
                                {
                                    <option value="@role" selected="@(role == usuario.Role)">@role</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-outline-primary btn-sm">Guardar</button>
                        </form>
                    </td>
                    <td><span class="badge @(usuario.Activo ? "bg-success" : "bg-secondary")">@(usuario.Activo ? "Activo" : "Inactivo")</span></td>
                    <td>
                        <form asp-action="ToggleActivo" method="post" class="d-inline">
                            <input type="hidden" name="userId" value="@usuario.UserId" />
                            <input type="hidden" name="activo" value="@(!usuario.Activo)" />
                            <button type="submit" class="btn btn-sm @(usuario.Activo ? "btn-outline-danger" : "btn-outline-success")">
                                @(usuario.Activo ? "Desactivar" : "Activar")
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
